# Copy to .env and fill in. .env is gitignored; this file holds names only, never values.

# The dispatch API (the Go backend).
API_URL=http://localhost:8080

# OpenRouter key for the model calls. Required.
OPENROUTER_API_KEY=

# Optional. Defaults shown.
# MODEL=deepseek/deepseek-v4.1-flash
# TICK_SECONDS=180
